{{- /* Feed RSS della home (layouts/rss.xml).
     Il modello predefinito infila nella home anche le pagine informative e le
     pagine di servizio: chi si iscrive si vede arrivare "Metodo e fonti" come
     se fosse una notizia. Qui passano solo gli articoli. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ with site.Params.description }}{{ . }}{{ else }}Raziel.news — Hermes, agenti autonomi, Venice.ai e Bitcoin: notizie verificate, con fonti.{{ end }}</description>
    <language>it-it</language>
    <copyright>©{{ now.Year }} Raziel</copyright>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{- range first 20 (where site.RegularPages "Section" "posts") }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <description>{{ with .Params.summary }}{{ . | html }}{{ else }}{{ .Summary | html }}{{ end }}</description>
      {{- range .Params.categories }}
      <category>{{ . | html }}</category>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
