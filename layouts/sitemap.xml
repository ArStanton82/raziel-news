{{- /* sitemap.xml proprio (layouts/sitemap.xml).
     Quello predefinito di Hugo elenca tutto: 70 URL di cui 60 non-articoli,
     cioè pagine di tag quasi vuote che diluiscono il segnale.
     Qui dentro: home, sezioni, articoli, pagine informative e le sei pagine
     dei temi. Fuori: /cerca/ (pagina di servizio) e tutte le pagine di tag. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Data.Pages }}
    {{- $dentro := false -}}
    {{- if or (eq .Kind "home") (eq .Kind "section") (eq .Kind "page") -}}
      {{- $dentro = true -}}
    {{- else if and (eq .Kind "term") (hasPrefix .RelPermalink "/categories/") -}}
      {{- $dentro = true -}}
    {{- end -}}
    {{- if and $dentro (ne .RelPermalink "/cerca/") }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" | safeHTML }}</lastmod>
    {{- end }}
    <changefreq>{{ if eq .Kind "home" }}daily{{ else if eq .Section "posts" }}weekly{{ else }}monthly{{ end }}</changefreq>
    <priority>{{ if eq .Kind "home" }}1.0{{ else if eq .Section "posts" }}0.8{{ else if eq .Kind "section" }}0.6{{ else if eq .Kind "term" }}0.5{{ else }}0.4{{ end }}</priority>
  </url>
    {{- end }}
  {{- end }}
</urlset>
