{{- $voci := slice -}}
{{- range where .Site.RegularPages "Section" "posts" -}}
    {{- $voci = $voci | append (dict
        "tipo" "articolo"
        "titolo" .Title
        "url" .RelPermalink
        "data" (.Date.Format "2006-01-02")
        "sommario" (default (.Summary | plainify | truncate 200) .Params.summary)
        "temi" (.Params.categories | default (slice))
        "tag" (.Params.tags | default (slice))
        "testo" (.Plain | truncate 6000)) -}}
{{- end -}}
{{- range where .Site.RegularPages "Section" "" -}}
    {{- $voci = $voci | append (dict
        "tipo" "pagina"
        "titolo" .Title
        "url" .RelPermalink
        "data" (.Date.Format "2006-01-02")
        "sommario" (default (.Summary | plainify | truncate 200) .Description)
        "temi" (slice)
        "tag" (slice)
        "testo" (.Plain | truncate 3000)) -}}
{{- end -}}
{{- dict "generato" (now.Format "2006-01-02T15:04:05Z07:00") "voci" $voci | jsonify -}}
