m/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://api.github.com/users/BearHuddleston/events{/privacy}","received_events_url":"https://api.github.com/users/BearHuddleston/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"da753b1b2e4577ae71ea836d691b0605e0641972","url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/da753b1b2e4577ae71ea836d691b0605e0641972","html_url":"https://github.com/NousResearch/hermes-agent/commit/da753b1b2e4577ae71ea836d691b0605e0641972"}]},{"sha":"da753b1b2e4577ae71ea836d691b0605e0641972","node_id":"C_kwDOPRF1G9oAKGRhNzUzYjFiMmU0NTc3YWU3MWVhODM2ZDY5MWIwNjA1ZTA2NDE5NzI","commit":{"author":{"name":"Kevin Rajan","email":"7121943+kvnloo@users.noreply.github.com","date":"2026-11-11T05:31:12Z"},"committer":{"name":"Bear Huddleston","email":"bear@bearhuddleston.dev","date":"2026-11-21T05:55:04Z"},"message":"fix(telegram): preserve disconnected draft result before lazy PTB install\n\nCredit BearHuddleston for the first-run draft fix and AliZakaee for reporting the lazy-install problem.\nKeep the no-bot failure contract while the optional Telegram dependency is still absent.\n\nThe ParseMode import now runs after the no-bot guard: a disconnected adapter returns\nnot_connected again instead of raising ModuleNotFoundError when python-telegram-bot is\nmissing. The added probe assertion fails on d1f52f77f2 and passes here.\n\n(cherry picked from commit bda1e423d754b07aa65f8cbd7af3b929803cc40f)","tree":{"sha":"fc9c3aaf900cfa186ed62ae9773376b4be35dc8b","url":"https://api.github.com/repos/NousResearch/hermes-agent/git/trees/fc9c3aaf900cfa186ed62ae9773376b4be35dc8b"},"url":"https://api.github.com/repos/NousResearch/hermes-agent/git/commits/da753b1b2e4577ae71ea836d691b0605e0641972","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/da753b1b2e4577ae71ea836d691b0605e0641972","html_url":"https://github.com/NousResearch/hermes-agent/commit/da753b1b2e4577ae71ea836d691b0605e0641972","comments_url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/da753b1b2e4577ae71ea836d691b0605e0641972/comments","author":{"login":"kvnloo","id":7121943,"node_id":"MDQ6VXNlcjcxMjE5NDM=","avatar_url":"https://avatars.githubusercontent.com/u/7121943?v=4","gravatar_id":"","url":"https://api.github.com/users/kvnloo","html_url":"https://github.com/kvnloo","followers_url":"https://api.github.com/users/kvnloo/followers","following_url":"https://api.github.com/users/kvnloo/following{/other_user}","gists_url":"https://api.github.com/users/kvnloo/gists{/gist_id}","starred_url":"https://api.github.com/users/kvnloo/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/kvnloo/subscriptions","organizations_url":"https://api.github.com/users/kvnloo/orgs","repos_url":"https://api.github.com/users/kvnloo/repos","events_url":"https://api.github.com/users/kvnloo/events{/privacy}","received_events_url":"https://api.github.com/users/kvnloo/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"BearHuddleston","id":196404565,"node_id":"U_kgDOC7TlVQ","avatar_url":"https://avatars.githubusercontent.com/u/196404565?v=4","gravatar_id":"","url":"https://api.github.com/users/BearHuddleston","html_url":"https://github.com/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://api.github.com/users/BearHuddleston/events{/privacy}","received_events_url":"https://api.github.com/users/BearHuddleston/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"aa0400f06d4519d170a184581adf840927f02a18","url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/aa0400f06d4519d170a184581adf840927f02a18","html_url":"https://github.com/NousResearch/hermes-agent/commit/aa0400f06d4519d170a184581adf840927f02a18"}]},{"sha":"aa0400f06d4519d170a184581adf840927f02a18","node_id":"C_kwDOPRF1G9oAKGFhMDQwMGYwNmQ0NTE5ZDE3MGExODQ1ODFhZGY4NDA5MjdmMDJhMTg","commit":{"author":{"name":"BearHuddleston","email":"bear@bearhuddleston.dev","date":"2026-11-11T01:21:15Z"},"committer":{"name":"Bear Huddleston","email":"bear@bearhuddleston.dev","date":"2026-11-21T05:55:04Z"},"message":"fix(telegram): drafts stream on the first gateway run after the on-demand python-telegram-bot install\n\nsend_draft read ParseMode from plugins.platforms.telegram.adapter, but the gateway\nruns the hermes_plugins.platforms__telegram.adapter copy. When python-telegram-bot is\nmissing at plugin load, both copies bind ParseMode = None, and the registry's\ninstaller (check_telegram_requirements) rebinds only the running copy. The first\ndraft frame then raised AttributeError ('NoneType' object has no attribute\n'MARKDOWN_V2'), the stream consumer logged it at DEBUG and turned drafts off, and\nevery DM turn streamed through edits until the gateway restarted.\n\nRegression from 7222595b82 (#151863), which moved the send_draft body out of\nadapter.py, where it read the running module's global. ParseMode now comes from\ntelegram.constants at call time, as standalone.py already does.\n\nThe new test runs real plugin discovery with telegram blocked, then the registry's\ncreate_adapter install path, and asserts the first draft goes out as MarkdownV2.\n\nReported-by: AliZakaee (#152827)","tree":{"sha":"6cce26503669cd270b2e0ee0f9f1c5314db941df","url":"https://api.github.com/repos/NousResearch/hermes-agent/git/trees/6cce26503669cd270b2e0ee0f9f1c5314db941df"},"url":"https://api.github.com/repos/NousResearch/hermes-agent/git/commits/aa0400f06d4519d170a184581adf840927f02a18","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/aa0400f06d4519d170a184581adf840927f02a18","html_url":"https://github.com/NousResearch/hermes-agent/commit/aa0400f06d4519d170a184581adf840927f02a18","comments_url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/aa0400f06d4519d170a184581adf840927f02a18/comments","author":{"login":"BearHuddleston","id":196404565,"node_id":"U_kgDOC7TlVQ","avatar_url":"https://avatars.githubusercontent.com/u/196404565?v=4","gravatar_id":"","url":"https://api.github.com/users/BearHuddleston","html_url":"https://github.com/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://