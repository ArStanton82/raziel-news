os/NousResearch/hermes-agent/git/trees/8103d07ba39a58e0c3ce8154e87ab5edb2a01253"},"url":"https://api.github.com/repos/NousResearch/hermes-agent/git/commits/b92488c29c05add7cce97cf232815628794c73ea","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/b92488c29c05add7cce97cf232815628794c73ea","html_url":"https://github.com/NousResearch/hermes-agent/commit/b92488c29c05add7cce97cf232815628794c73ea","comments_url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/b92488c29c05add7cce97cf232815628794c73ea/comments","author":{"login":"BearHuddleston","id":196404565,"node_id":"U_kgDOC7TlVQ","avatar_url":"https://avatars.githubusercontent.com/u/196404565?v=4","gravatar_id":"","url":"https://api.github.com/users/BearHuddleston","html_url":"https://github.com/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://api.github.com/users/BearHuddleston/events{/privacy}","received_events_url":"https://api.github.com/users/BearHuddleston/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"BearHuddleston","id":196404565,"node_id":"U_kgDOC7TlVQ","avatar_url":"https://avatars.githubusercontent.com/u/196404565?v=4","gravatar_id":"","url":"https://api.github.com/users/BearHuddleston","html_url":"https://github.com/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://api.github.com/users/BearHuddleston/events{/privacy}","received_events_url":"https://api.github.com/users/BearHuddleston/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e75272d80e5844e02ed726581f5a1eef98705d05","url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/e75272d80e5844e02ed726581f5a1eef98705d05","html_url":"https://github.com/NousResearch/hermes-agent/commit/e75272d80e5844e02ed726581f5a1eef98705d05"}]},{"sha":"e75272d80e5844e02ed726581f5a1eef98705d05","node_id":"C_kwDOPRF1G9oAKGU3NTI3MmQ4MGU1ODQ0ZTAyZWQ3MjY1ODFmNWExZWVmOTg3MDVkMDU","commit":{"author":{"name":"BearHuddleston","email":"bear@bearhuddleston.dev","date":"2026-11-21T01:02:25Z"},"committer":{"name":"Bear Huddleston","email":"bear@bearhuddleston.dev","date":"2026-11-21T05:55:04Z"},"message":"fix(telegram): read ParseMode from telegram.constants in vault-code prompts\n\ntelegram_vault_code.py landed after this PR was first written and imported\nParseMode from plugins.platforms.telegram.adapter at both send and card-edit\nsites. On a first gateway run after on-demand python-telegram-bot install,\nthat sibling copy still binds ParseMode = None while only the running\nhermes_plugins copy is rebound, so send_vault_code_prompt raised\nAttributeError and _mark_vault_code_card failed silently.\n\nRead ParseMode from telegram.constants at both sites and extend the lazy\ninstall probe to exercise send_vault_code_prompt and _mark_vault_code_card.","tree":{"sha":