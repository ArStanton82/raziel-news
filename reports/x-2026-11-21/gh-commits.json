[{"sha":"a3b993b98a1c679193bd8d4ea99b89ce7614bfde","node_id":"C_kwDOPRF1G9oAKGEzYjk5M2I5OGExYzY3OTE5M2JkOGQ0ZWE5OWI4OWNlNzYxNGJmZGU","commit":{"author":{"name":"BearHuddleston","email":"bear@bearhuddleston.dev","date":"2026-11-12T08:42:09Z"},"committer":{"name":"Bear Huddleston","email":"bear@bearhuddleston.dev","date":"2026-11-21T06:26:07Z"},"message":"docs(release): source checkouts follow GitHub's latest release, not the R2 pointer\n\nstable-releases.md said that official source checkouts follow\nreleases/stable/release-candidates.json, so a release without the full\ndesktop lane set leaves them on the previous full release too. The code\nsays otherwise: the source updater's stable channel is\nhermes_cli/source_releases.py::_resolve_stable, which resolves GitHub's\nlatest published vX.Y.Z release with pointer=False and reads no R2\nrecord (158cd52a6b). The sentence arrived five days after that change,\nwith the lanes section (36a8ee18cd). That gap is why source checkouts on\nstable are on v0.23.1 while the out-of-Store desktop feeds are still on\nv0.22.0.\n\nThe one-off build section also said `main` is the only valid source\nchannel, which predates the stable default: update_channel.default_channel\ngives official-repository checkouts `stable` and forks and mirrors\n`main`, and `hermes update --set-channel` changes either.","tree":{"sha":"02dce0129e546a0f923b40d62386e76a113cc37f","url":"https://api.github.com/repos/NousResearch/hermes-agent/git/trees/02dce0129e546a0f923b40d62386e76a113cc37f"},"url":"https://api.github.com/repos/NousResearch/hermes-agent/git/commits/a3b993b98a1c679193bd8d4ea99b89ce7614bfde","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/a3b993b98a1c679193bd8d4ea99b89ce7614bfde","html_url":"https://github.com/NousResearch/hermes-agent/commit/a3b993b98a1c679193bd8d4ea99b89ce7614bfde","comments_url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/a3b993b98a1c679193bd8d4ea99b89ce7614bfde/comments","author":{"login":"BearHuddleston","id":196404565,"node_id":"U_kgDOC7TlVQ","avatar_url":"https://avatars.githubusercontent.com/u/196404565?v=4","gravatar_id":"","url":"https://api.github.com/users/BearHuddleston","html_url":"https://github.com/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://api.github.com/users/BearHuddleston/events{/privacy}","received_events_url":"https://api.github.com/users/BearHuddleston/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"BearHuddleston","id":196404565,"node_id":"U_kgDOC7TlVQ","avatar_url":"https://avatars.githubusercontent.com/u/196404565?v=4","gravatar_id":"","url":"https://api.github.com/users/BearHuddleston","html_url":"https://github.com/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://api.github.com/users/BearHuddleston/events{/privacy}","received_events_url":"https://api.github.com/users/BearHuddleston/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7c34e2dbb469f2562648a9c689125edfaddfae6d","url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/7c34e2dbb469f2562648a9c689125edfaddfae6d","html_url":"https://github.com/NousResearch/hermes-agent/commit/7c34e2dbb469f2562648a9c689125edfaddfae6d"}]},{"sha":"7c34e2dbb469f2562648a9c689125edfaddfae6d","node_id":"C_kwDOPRF1G9oAKDdjMzRlMmRiYjQ2OWYyNTYyNjQ4YTljNjg5MTI1ZWRmYWRkZmFlNmQ","commit":{"author":{"name":"BearHuddleston","email":"bear@bearhuddleston.dev","date":"2026-11-21T01:05:45Z"},"committer":{"name":"Bear Huddleston","email":"bear@bearhuddleston.dev","date":"2026-11-21T05:55:44Z"},"message":"fix(desktop): drop the whole live tail past a stored prompt so streams survive\n\nWhen withoutLiveTurnsThePageStores stripped a stored turn's live prompt and\npending stream but kept later unstored rows (a queued follow-up prompt or an\ninterim bubble), acknowledgedTranscriptBoundary / ordinal pairing saw those\nleftover rows and skipped the running turn's streaming reply.\n\nDrop the entire trailing slice starting at the stored live prompt so the\npending-turn reconcilers see the same boundary as the short-chat path and\nre-attach the live stream and queued follow-ups in order. Also match by\nsubmissionId in preserveLocalPendingTurnMessages so a prompt whose stored\ntext differs from its optimistic text is not re-appended.","tree":{"sha":"ed288bef07c040213265fc0788e20fcaae1fa18f","url":"https://api.github.com/repos/NousResearch/hermes-agent/git/trees/ed288bef07c040213265fc0788e20fcaae1fa18f"},"url":"https://api.github.com/repos/NousResearch/hermes-agent/git/commits/7c34e2dbb469f2562648a9c689125edfaddfae6d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/7c34e2dbb469f2562648a9c689125edfaddfae6d","html_url":"https://github.com/NousResearch/hermes-agent/commit/7c34e2dbb469f2562648a9c689125edfaddfae6d","comments_url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/7c34e2dbb469f2562648a9c689125edfaddfae6d/comments","author":{"login":"BearHuddleston","id":196404565,"node_id":"U_kgDOC7TlVQ","avatar_url":"https://avatars.githubusercontent.com/u/196404565?v=4","gravatar_id":"","url":"https://api.github.com/users/BearHuddleston","html_url":"https://github.com/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://api.github.com/users/BearHuddleston/events{/privacy}","received_events_url":"https://api.github.com/users/BearHuddleston/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"BearHuddleston","id":196404565,"node_id":"U_kgDOC7TlVQ","avatar_url":"https://avatars.githubusercontent.com/u/196404565?v=4","gravatar_id":"","url":"https://api.github.com/users/BearHuddleston","html_url":"https://github.com/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://api.github.com/users/BearHuddleston/events{/privacy}","received_events_url":"https://api.github.com/users/BearHuddleston/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"63b0f55d07975f6d90e627b839abe4720b5c834b","url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/63b0f55d07975f6d90e627b839abe4720b5c834b","html_url":"https://github.com/NousResearch/hermes-agent/commit/63b0f55d07975f6d90e627b839abe4720b5c834b"}]},{"sha":"63b0f55d07975f6d90e627b839abe4720b5c834b","node_id":"C_kwDOPRF1G9oAKDYzYjBmNTVkMDc5NzVmNmQ5MGU2MjdiODM5YWJlNDcyMGI1YzgzNGI","commit":{"author":{"name":"BearHuddleston","email":"bear@bearhuddleston.dev","date":"2026-11-06T08:01:03Z"},"committer":{"name":"Bear Huddleston","email":"bear@bearhuddleston.dev","date":"2026-11-21T05:55:44Z"},"message":"fix(desktop): draw a running turn once when a long chat refreshes mid-turn\n\nA running turn stores its prompt when it starts and each tool round as it\nfinishes, long before message.complete brings the receipt that ties the\nlive rows to those stored rows. In a chat longer than one page, the newest\npage starts inside an older turn, so a refresh that lands mid-turn\n(reopening the chat, a background read) takes the stored-id merge. That\nmerge kept every window row without a stored id at the end, after the\npage's stored copies: the optimistic prompt and the stream bubble drew\nagain below the stored prompt and its finished tool rounds. The pending-turn\nreconcile that runs next found both live rows already present by id and\nnever paired them, so the duplicate stayed until a reload (#145333).\n\nThe owner stamps the admission's submission_id on the user row the turn\nstores (display_metadata.submission_id, 4c333e0d49), and the live prompt's\nid is user-<submission_id>. Hydration now carries that id onto the stored\nprompt, and the stored-id merge leaves a live prompt whose own send the\npage stores, with the stream that follows it, to that reconcile, as the\nmerge already does when the page holds the whole chat. A live send the\npage does not store yet, even one repeating the words of a stored prompt,\nkeeps its place.\n\nRefs #145333","tree":{"sha":"b31faa6a6dd158f2e82f244f05827a10f005f0b3","url":"https://api.github.com/repos/NousResearch/hermes-agent/git/trees/b31faa6a6dd158f2e82f244f05827a10f005f0b3"},"url":"https://api.github.com/repos/NousResearch/hermes-agent/git/commits/63b0f55d07975f6d90e627b839abe4720b5c834b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/63b0f55d07975f6d90e627b839abe4720b5c834b","html_url":"https://github.com/NousResearch/hermes-agent/commit/63b0f55d07975f6d90e627b839abe4720b5c834b","comments_url":"https://api.github.com/repos/NousResearch/hermes-agent/commits/63b0f55d07975f6d90e627b839abe4720b5c834b/comments","author":{"login":"BearHuddleston","id":196404565,"node_id":"U_kgDOC7TlVQ","avatar_url":"https://avatars.githubusercontent.com/u/196404565?v=4","gravatar_id":"","url":"https://api.github.com/users/BearHuddleston","html_url":"https://github.com/BearHuddleston","followers_url":"https://api.github.com/users/BearHuddleston/followers","following_url":"https://api.github.com/users/BearHuddleston/following{/other_user}","gists_url":"https://api.github.com/users/BearHuddleston/gists{/gist_id}","starred_url":"https://api.github.com/users/BearHuddleston/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/BearHuddleston/subscriptions","organizations_url":"https://api.github.com/users/BearHuddleston/orgs","repos_url":"https://api.github.com/users/BearHuddleston/repos","events_url":"https://api.github.com/users/BearHuddleston/events{/privacy}","received_events_url":"https://api.github.com/users/BearHuddleston/received_events","type":"Us